# Normalisasi akhiran baris supaya seragam di mesin siapa pun.
* text=auto

# Batch file WAJIB CRLF. Dengan akhiran baris LF, cmd.exe bisa salah membaca
# label dan goto -- gejalanya aneh dan susah dilacak.
*.bat text eol=crlf
*.cmd text eol=crlf

# Peluncur macOS WAJIB LF, dan ini kebalikannya yang di atas. Berkas .command
# ditulis di Windows, dan tanpa aturan ini git meng-checkout-nya dengan CRLF.
# Di macOS akibatnya bash membaca \r sebagai bagian dari perintah, lalu gagal
# dengan pesan menyesatkan semacam: command not found: $'\r'.
*.command text eol=lf
*.sh      text eol=lf

# Kode & konfigurasi: LF, konvensi lintas platform.
*.py   text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.txt  text eol=lf
*.tsv  text eol=lf

# Data: jangan disentuh, biar hash-nya stabil.
*.csv  -text
*.png  binary
